{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness4contract.local/schemas/capability-report.schema.json",
  "type": "object",
  "required": ["contract_version", "adapter", "capabilities"],
  "properties": {
    "contract_version": {"type": "string"},
    "adapter": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "evidence"],
        "properties": {
          "status": {"enum": ["native", "equivalent", "degraded", "unconfigured", "error"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

