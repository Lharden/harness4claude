{
  "description": "Harness v3 SDD — Pipeline orchestrator with L0/L1/L2 classification, git guardrails, state snapshots, and auto-reclassification. Branch Keeper: sensor passivo de ramificacao e deriva com parking reversivel.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-classify.sh\"",
            "timeout": 10000,
            "statusMessage": "Classificando tarefa..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-skill-router.sh\"",
            "timeout": 5000,
            "statusMessage": "Skill router..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-branch-sensor.sh\"",
            "timeout": 8000,
            "statusMessage": "Branch Keeper: sensor de ramo..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/science_intent.py\"",
            "timeout": 5000,
            "statusMessage": "Science evidence routing..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-git-guard.sh\"",
            "timeout": 5000,
            "statusMessage": "Git guardrails..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-arsenal-gate.sh\"",
            "timeout": 8000,
            "statusMessage": "Arsenal: orcamento do roster..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-reclassify.sh\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-precompact.sh\"",
            "timeout": 10000,
            "statusMessage": "Salvando snapshot de handoff..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-lifecycle.py\" --event PostCompact",
            "timeout": 5000,
            "statusMessage": "Restaurando pipeline transacional..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-lifecycle.py\" --event SubagentStart",
            "timeout": 5000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-lifecycle.py\" --event SubagentStop",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-session-start.sh\"",
            "timeout": 15000,
            "statusMessage": "Inicializando Harness v3..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-graphify-autosetup.sh\"",
            "timeout": 10000,
            "statusMessage": "Graphify auto-setup..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-router-warmup.sh\"",
            "timeout": 5000,
            "statusMessage": "Router warmup..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-branch-sensor.sh\"",
            "timeout": 8000,
            "statusMessage": "Branch Keeper: sensor de ramo..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-lifecycle.py\" --event SessionEnd",
            "timeout": 5000,
            "statusMessage": "Fechando telemetria do Harness..."
          }
        ]
      }
    ]
  }
}
